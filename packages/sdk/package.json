{
  "name": "@scope-ai/sdk",
  "version": "0.4.0",
  "description": "SCOPE tracing SDK: record traces and spans from any TypeScript application.",
  "keywords": [
    "llm",
    "tracing",
    "observability",
    "opentelemetry",
    "sdk"
  ],
  "homepage": "https://github.com/tanmaytyagii/scope#readme",
  "bugs": {
    "url": "https://github.com/tanmaytyagii/scope/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmaytyagii/scope.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "scope-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scope-ai/core": "0.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "openai": "^7.23.0"
  }
}
