{
  "name": "@scope-ai/config",
  "version": "0.1.0",
  "description": "Workflow and project configuration for SCOPE: schemas, validation with source locations, templating and datasets.",
  "keywords": [
    "llm",
    "workflow",
    "yaml"
  ],
  "homepage": "https://github.com/tanmaytyagii/scope#readme",
  "bugs": {
    "url": "https://github.com/tanmaytyagii/scope/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmaytyagii/scope.git",
    "directory": "packages/config"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scope-ai/core": "0.1.0",
    "zod": "^4.6.5",
    "yaml": "^2.9.1"
  }
}
