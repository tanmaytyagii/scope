# Copy to deploy/.env and fill in. Never commit .env.

# PostgreSQL password. Letters and digits only (it is part of a URL), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=

# The public name of the server, for HTTPS through Caddy (`docker compose --profile https up -d`).
# Point its DNS at this machine first; Caddy gets a certificate from Let's Encrypt.
SCOPE_DOMAIN=scope.example.com

# Delete runs and application traces older than this, hourly (e.g. 30d). "off" keeps everything.
SCOPE_RETENTION=off

# Largest ingest request in bytes (raise together with the SDK's maxBatchBytes).
SCOPE_MAX_INGEST_BYTES=5242880
