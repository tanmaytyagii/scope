{
  "name": "@scope-ai/engine",
  "version": "0.2.0",
  "description": "SCOPE workflow engine: executes workflows, traces every step, and evaluates the results.",
  "keywords": [
    "llm",
    "workflow",
    "evaluation"
  ],
  "homepage": "https://github.com/tanmaytyagii/scope#readme",
  "bugs": {
    "url": "https://github.com/tanmaytyagii/scope/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmaytyagii/scope.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "scope-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scope-ai/core": "0.2.0",
    "@scope-ai/config": "0.2.0",
    "@scope-ai/providers": "0.2.0",
    "@scope-ai/evaluators": "0.2.0",
    "@scope-ai/sdk": "0.2.0",
    "zod": "^4.6.5"
  }
}
