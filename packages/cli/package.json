{
  "name": "@scope-ai/cli",
  "version": "0.2.0",
  "description": "The scope command-line tool: run, evaluate, compare and inspect AI workflows.",
  "keywords": [
    "llm",
    "ai",
    "evaluation",
    "tracing",
    "cli"
  ],
  "homepage": "https://github.com/tanmaytyagii/scope#readme",
  "bugs": {
    "url": "https://github.com/tanmaytyagii/scope/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmaytyagii/scope.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "scope": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@scope-ai/core": "0.2.0",
    "@scope-ai/config": "0.2.0",
    "@scope-ai/providers": "0.2.0",
    "@scope-ai/evaluators": "0.2.0",
    "@scope-ai/sdk": "0.2.0",
    "@scope-ai/engine": "0.2.0",
    "@scope-ai/storage": "0.2.0",
    "commander": "^15.0.0",
    "@scope-ai/server": "0.2.0"
  }
}
