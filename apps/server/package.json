{
  "name": "@scope-ai/server",
  "version": "0.4.0",
  "description": "SCOPE server: the HTTP API, trace ingestion and dashboard hosting.",
  "keywords": [
    "llm",
    "observability",
    "dashboard",
    "api"
  ],
  "homepage": "https://github.com/tanmaytyagii/scope#readme",
  "bugs": {
    "url": "https://github.com/tanmaytyagii/scope/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanmaytyagii/scope.git",
    "directory": "apps/server"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "scope-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@scope-ai/core": "0.4.0",
    "@scope-ai/protocol": "0.4.0",
    "@scope-ai/storage": "0.4.0",
    "@scope-ai/web": "0.4.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/otel": "^1.0.127",
    "@arizeai/openinference-instrumentation-langchain": "^4.1.4",
    "@arizeai/openinference-instrumentation-openai": "^4.3.2",
    "@langchain/core": "^1.2.14",
    "@langchain/openai": "^1.6.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@scope-ai/config": "0.4.0",
    "@scope-ai/engine": "0.4.0",
    "@scope-ai/sdk": "0.4.0",
    "@traceloop/instrumentation-langchain": "^0.27.0",
    "@traceloop/instrumentation-openai": "^0.27.0",
    "ai": "^7.0.122",
    "openai": "^7.27.0"
  }
}
